#!/bin/sh
# sakina-access-openwrt: give Sakina access to this OpenWrt router, or take it back.
# Kept for routers whose old update fetches this file; it hands over to sakina-access.
set -eu
export PATH="${PATH:+$PATH:}/usr/sbin:/usr/bin:/sbin:/bin"
URL=https://raw.githubusercontent.com/Lumysia/Yggdrasil/main/scripts/sakina-access/sakina-access
HEADER='# sakina-access: give Sakina access to this Linux host, or take it back.'
SELF=${SAKINA_ACCESS_ROOT:-}/usr/sbin/sakina-access

new=$(mktemp)
trap 'rm -f "$new"' EXIT
if command -v curl >/dev/null 2>&1; then curl -fsSL --retry 3 --max-time 60 -o "$new" "$URL"
elif command -v uclient-fetch >/dev/null 2>&1; then uclient-fetch -q -T 60 -O "$new" "$URL"
else wget -q -T 60 -O "$new" "$URL"
fi
sh -n "$new"
[ "$(sed -n 2p "$new")" = "$HEADER" ]
mkdir -p "$(dirname "$SELF")"
cp "$new" "$SELF.new" && chmod 0755 "$SELF.new" && mv "$SELF.new" "$SELF"
logger -t sakina-access "moved to the shared sakina-access script"
sh "$SELF" "$@"
