GAMES_PATH=/data/games

# Minecraft
TYPE=CURSEFORGE
CF_SERVER_MOD=/downloads/Craft to Exile 2 SERVER-1.1.3.zip
MEMORY=16G
MAX_PLAYERS=25
ONLINE_MODE=true
ALLOW_FLIGHT=true
VIEW_DISTANCE=10
DIFFICULTY=normal
SERVER_NAME=Cats Federation - Craft to Exile 2
MOTD=Welcome to Craft to Exile 2!
PVP=true
EULA=true
USE_AIKAR_FLAGS=true

# FTB quest translation overrides
COPY_CONFIG_DEST=/data/config
SYNC_SKIP_NEWER_IN_DESTINATION=false

# Backup
BACKUP_INTERVAL="15m"
PAUSE_IF_NO_PLAYERS=true
RCON_HOST=cte2
BACKUP_METHOD=restic
RESTIC_PASSWORD=RKQW7vFCXMaedoWCPA9Gs # Intentionally Public Password
RESTIC_REPOSITORY=RKQW
PRUNE_RESTIC_RETENTION=--keep-last 96 --keep-hourly 168 --keep-daily 90 --keep-weekly 52 --keep-monthly 36

# Compose YAML
MC_FOLDER_NAME=mc-craft-to-exile-2
MC_JAVA_VERSION=java21
MC_PORT=25565
