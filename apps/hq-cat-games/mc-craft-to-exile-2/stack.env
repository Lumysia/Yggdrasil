GAMES_PATH=/data/games

# Minecraft
TYPE=CURSEFORGE
CF_SERVER_MOD=/downloads/Craft to Exile 2 SERVER-1.1.3.zip
VERSION=1.20.1
MEMORY=16G
MAX_PLAYERS=25
ONLINE_MODE=true
ALLOW_FLIGHT=true
ENABLE_COMMAND_BLOCK=true
VIEW_DISTANCE=10
DIFFICULTY=normal
SERVER_NAME=Cats Federation - Craft to Exile 2
MOTD=Welcome to Craft to Exile 2!
PVP=true
EULA=true
USE_AIKAR_FLAGS=true

# FTB quest translation overrides
COPY_CONFIG_DEST=/data/FeedTheBeast/config
SYNC_SKIP_NEWER_IN_DESTINATION=false

# BlueMap
MODS=https://cdn.modrinth.com/data/swbUV1cr/versions/kC7iYqja/bluemap-5.12-mc1.20-6-forge.jar
MODS_OUT_DIR=/data/FeedTheBeast/mods
COPY_MODS_DEST=/data/FeedTheBeast/mods

# Compose YAML
MC_FOLDER_NAME=mc-craft-to-exile-2
MC_JAVA_VERSION=java21
MC_PORT=25565
