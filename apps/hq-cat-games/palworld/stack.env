GAMES_PATH=/data/games
PUID=1000
PGID=1000

# Compose YAML
PAL_MEMORY_MAX=16G

# PalWorld Configs
PORT=8211
PUBLIC_PORT=8211
PLAYERS=16
MULTITHREADING=true

COMMUNITY=true
SERVER_DESCRIPTION=Welcome!
CROSSPLAY_PLATFORMS=(Steam,Xbox,PS5,Mac)

UPDATE_ON_BOOT=true

REST_API_ENABLED=true
REST_API_PORT=8212

RCON_ENABLED=false

AUTO_PAUSE_ENABLED=true
ENABLE_PLAYER_LOGGING=true
AUTO_PAUSE_TIMEOUT_EST=600
AUTO_PAUSE_LOG=true

BACKUP_ENABLED=true
BACKUP_CRON_EXPRESSION=0 */6 * * *
USE_BACKUP_SAVE_DATA=true
DELETE_OLD_BACKUPS=true
OLD_BACKUP_DAYS=14

AUTO_REBOOT_ENABLED=true
AUTO_REBOOT_CRON_EXPRESSION=0 6 * * *
AUTO_REBOOT_WARN_MINUTES=5
AUTO_REBOOT_EVEN_IF_PLAYERS_ONLINE=false

PAL_CAPTURE_RATE=3
PLAYER_STAMINA_DECREASE_RATE=0.5
PLAYER_AUTO_HP_REGEN_RATE=2
PAL_STAMINA_DECREASE_RATE=0.5
PAL_AUTO_HP_REGEN_RATE=2
ENEMY_DROP_ITEM_RATE=3

# BUILD_OBJECT_DETERIORATION_DAMAGE_RATE=0
PAL_EGG_DEFAULT_HATCHING_TIME=0.1
DEATH_PENALTY=None

BASE_CAMP_WORKER_MAX_NUM=20
BASE_CAMP_MAX_NUM_IN_GUILD=4
SHOW_PLAYER_LIST=true
ALLOW_CLIENT_MOD=false
