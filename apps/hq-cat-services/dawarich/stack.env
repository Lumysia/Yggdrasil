APPDATA_PATH=/data/appdata
DB_PATH=/data/db

# Dawarich
RAILS_ENV=production
RAILS_LOG_TO_STDOUT=true
SELF_HOSTED=true
APPLICATION_PROTOCOL=https
TIME_ZONE=America/Toronto
STORE_GEODATA=true
SIDEKIQ_EMBEDDED=true
WEB_CONCURRENCY=0
BACKGROUND_PROCESSING_CONCURRENCY=2
REDIS_URL=redis://redis:6379
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USERNAME=dawarich
DATABASE_PASSWORD=dawarich
DATABASE_NAME=dawarich

# Login only through Pocket ID (public PKCE client)
OIDC_CLIENT_ID=6c7af7d8-a559-40b9-a9ed-0e8ce00cb35b
OIDC_PKCE_ENABLED=true
OIDC_PROVIDER_NAME=Pocket ID
OIDC_AUTO_REGISTER=true
ALLOW_EMAIL_PASSWORD_LOGIN=false
ALLOW_EMAIL_PASSWORD_REGISTRATION=false

# Postgres (internal-only network); Dawarich's DATABASE_* credentials above match these
POSTGRES_USER=dawarich
POSTGRES_PASSWORD=dawarich
POSTGRES_DB=dawarich
