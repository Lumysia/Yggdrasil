APPDATA_PATH=/data/appdata
DB_PATH=/data/db

# sub2api
TIME_ZONE=Etc/UTC
AUTO_SETUP=true
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_MODE=release
RUN_MODE=standard
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_SSLMODE=disable
DATABASE_MAX_OPEN_CONNS=50
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME_MINUTES=30
DATABASE_CONN_MAX_IDLE_TIME_MINUTES=5
REDIS_HOST=redis
REDIS_PORT=6379
JWT_EXPIRE_HOUR=24

# Postgres (internal-only network); sub2api's DATABASE_* credentials are built from these in compose.yaml
POSTGRES_USER=sub2api
POSTGRES_PASSWORD=sub2api
POSTGRES_DB=sub2api
PGDATA=/var/lib/postgresql
