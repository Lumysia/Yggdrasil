APPDATA_PATH=/root/docker

GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443
GATEWAY_WEB_HTTP_PORT=18080
GATEWAY_WEB_HTTPS_PORT=18443
GATEWAY_TLS_FALLBACK_TARGET=127.0.0.1:21443
# GATEWAY_TLS_ROUTES is injected from COMMON_ENTRY_GATEWAY_TLS_ROUTES by compose.yaml.

# Tailscale addresses of the origin hosts behind this gateway.
# MagicDNS names don't resolve here: the host keeps its own resolvers (Tailscale accept-dns is off).
HQ_CAT_GAMES_TAILSCALE_IP=100.110.4.6
HQ_CAT_SERVICES_TAILSCALE_IP=100.126.143.61

GATEWAY_FILE_TLS_TARGET=${HQ_CAT_SERVICES_TAILSCALE_IP}:443
GATEWAY_TCP_ROUTES=50354=${HQ_CAT_GAMES_TAILSCALE_IP}:25565
GATEWAY_PALWORLD_UDP_PORT=8211
GATEWAY_PALWORLD_UDP_TARGET=${HQ_CAT_GAMES_TAILSCALE_IP}:8211
